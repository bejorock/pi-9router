{
  "name": "pi-9router",
  "version": "0.2.0",
  "description": "Register 9router (an OpenAI-compatible AI routing proxy) as a native provider for pi, with dynamic model discovery.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "9router",
    "ai-router",
    "openai-proxy"
  ],
  "license": "MIT",
  "author": "Rana Lubis <rana.lubis@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@types/node": "^24.19.2",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  }
}
